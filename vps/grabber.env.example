# Oracle API key (Oracle console -> My profile -> API keys)
OCI_USER_OCID=ocid1.user.oc1..xxxx
OCI_TENANCY_OCID=ocid1.tenancy.oc1..xxxx
OCI_FINGERPRINT=aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99
OCI_REGION=ap-mumbai-1
# Key files live next to this file (chmod 600)
OCI_PRIVATE_KEY_FILE=/etc/safha-grabber/oci_api_key.pem
OCI_SSH_PUBLIC_KEY_FILE=/etc/safha-grabber/ssh.pub
# Optional
KAGGLE_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_EACH=1
# One launch request every 5 minutes; sizes take turns (2 OCPU/12 GB, then 1/6)
ATTEMPTS=1000000
ATTEMPT_GAP_S=300
